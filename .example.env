# Copy this file to .env and fill in your Vertex AI project details.
# Docker Compose reads .env automatically; never commit that file.

VERTEXAI_PROJECT=your-gcp-project-id
# `global` returns the global Vertex publisher-model catalog.
VERTEXAI_LOCATION=global
# Generate a distinct value, for example: openssl rand -base64 32
VERTEXAI_PROXY_API_KEY=replace-with-a-long-random-secret
